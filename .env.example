# 安装内核 可选：mihomo、clash
KERNEL_NAME=mihomo

# 安装路径
CLASH_BASE_DIR=~/clashctl

# 机场订阅
CLASH_CONFIG_URL=

# 下载订阅时的 UserAgent
CLASH_SUB_UA=mihomo

# init 系统（自动识别）
INIT_TYPE=

# Web UI 压缩包
ZIP_UI=resources/zip/dist.zip

# GitHub 加速下载代理
URL_GH_PROXY=https://gh-proxy.org

# 依赖下载超时时间（秒）
CLASHCTL_DOWNLOAD_TIMEOUT=60

# 是否优先查询依赖最新版本；失败时回退到下方固定版本
CLASHCTL_CHECK_LATEST_VERSION=1

# 公共 Web 控制台
URL_CLASH_UI=http://board.zash.run.place

# 依赖固定版本
VERSION_MIHOMO=v1.19.27
VERSION_YQ=v4.53.3
VERSION_SUBCONVERTER=v0.9.9

# 默认使用支持更多协议的社区版 subconverter
# SUBCONVERTER_REPO=tindy2013/subconverter
SUBCONVERTER_REPO=asdlokj1qpi233/subconverter
